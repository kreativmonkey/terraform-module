# Keep etcd peer/client traffic on the LAN. Without this, etcd may pick a mesh
# address (e.g. Netbird 100.96.x.x) as its advertised/peer address, which breaks
# node-to-node operations such as rotate-ca. advertisedSubnets may carry explicit
# excludes (e.g. "!100.64.0.0/10").
cluster:
  etcd:
    advertisedSubnets: ${jsonencode(advertised_subnets)}
    listenSubnets: ${jsonencode(listen_subnets)}
